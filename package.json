{
  "name": "vallaury-desktop",
  "productName": "Vallaury",
  "version": "0.1.0",
  "description": "Vallaury for Windows, Linux and macOS: a window around app.vallaury.it.",
  "license": "GPL-3.0-only",
  "author": "Francesco Sappa",
  "homepage": "https://app.vallaury.it",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p . && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc -p . --noEmit",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.14.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "desktopName": "vallaury.desktop",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sappafrancesco/vallaury-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/sappafrancesco/vallaury-desktop/issues"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
